# Normalize line endings across platforms.
* text=auto

# The Gradle wrapper shell script MUST stay LF or it won't run on Linux/macOS.
gradlew text eol=lf
*.sh text eol=lf

# Windows batch scripts need CRLF.
*.bat text eol=crlf

# Binary files — never touch line endings.
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.keystore binary
*.jks binary
